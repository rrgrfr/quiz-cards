{
  "name": "personal-quiz",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Персональное приложение для обучения тестовыми карточками",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-budget.mjs",
